# Ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_WINDOW=8192

# MySQL ingestion account (requires CREATE/ALTER/INSERT/DROP during bootstrap)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=supercomputer_analytics
MYSQL_INGEST_USER=root
MYSQL_INGEST_PASSWORD=change_me

# MySQL chatbot account (use a SELECT-only account in production)
MYSQL_QUERY_USER=supercomputer_reader
MYSQL_QUERY_PASSWORD=change_me

# MySQL chat-history account (SELECT/INSERT/UPDATE/DELETE on chat tables)
MYSQL_CHAT_USER=supercomputer_chat
MYSQL_CHAT_PASSWORD=change_me
MYSQL_POOL_SIZE=5
MYSQL_CONNECT_TIMEOUT=10
MYSQL_QUERY_TIMEOUT_MS=10000
MYSQL_INSERT_BATCH_SIZE=500
SQL_RESULT_ROW_LIMIT=200

# Qdrant server or cloud. Leave QDRANT_URL blank only for local development mode.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=supercomputer_knowledge
QDRANT_PREFER_GRPC=false
QDRANT_TIMEOUT_SECONDS=30
QDRANT_TOP_K=8
QDRANT_UPLOAD_BATCH_SIZE=64

# Used only when QDRANT_URL is blank
QDRANT_LOCAL_PATH=runtime/qdrant

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64

# Application
APP_DEBUG=false
MAX_CHAT_HISTORY_CHARS=6000
CHAT_CONTEXT_MESSAGE_LIMIT=10
CHAT_TITLE_MAX_LENGTH=80
